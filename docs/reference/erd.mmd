%% Service Blueprint ERD
%%
%% REGENERATED FROM THE LIVE SCHEMA on 2026-08-20, not hand-edited. The previous
%% version claimed to be "verified through 20260716120000_layer_role.sql
%% (2026-07-16)" and had drifted for five weeks and eleven migrations: it was
%% missing the entire derived layer (evidence, findings, slices, slice_items,
%% propositions) which shipped 2026-07-29, and every name in the vocabulary
%% refactor.
%%
%% To refresh, re-run the two queries in
%% docs/reference/schema-snapshot-queries.sql against the live database and
%% rewrite this file plus supabase/schema.reference.sql from their output. A
%% file that has to be remembered is a file that drifts, so the queries ship
%% next to the output.
%%
%% Enums (CHECK constraints, live):
%%   scenarios.view_type         ∈ (single | stacked)   merged is session-only,
%%                                                      never stored
%%   paths.path_type             ∈ (happy | unhappy | exception | alternative | named)
%%   cell_dependencies.kind      ∈ (sets_off | enables)
%%   origin (cells/lanes/paths/phases/scenarios/steps/slices) ∈ (import | app)
%%
%% Integrity: cells.path_id must match lanes.path_id AND (path_id, step_id) must
%%            exist in path_steps — DB trigger cells_validate_path_match. Import
%%            order: paths → steps → path_steps → lanes → cells → cell_dependencies.
%%
%% Roles: lanes.lane_role is a semantic key kept separate from the display name,
%%        because inferring one from the other broke every non-English blueprint.
%%        Canonical: customer_actions, frontstage_actions, backstage_actions,
%%        frontstage_tech, backstage_tech, support_systems, visual, step_visual.
%%        Extensible; null = generic swimlane.
%%
%% Naming note: `service_lifecycles` is the real root — it has NO foreign key to
%%        or from `services`, which holds one unused placeholder row. Plan 002
%%        Phase 6 renames it to `services` and drops the placeholder; that phase
%%        is PINNED with the rest of the service tier, so both still appear here.
erDiagram
  service_lifecycles ||--o{ phases : "has many"
  phases             ||--o{ scenarios : "has many"
  phases             |o--o| phases : "loops_to_phase_id"
  scenarios          ||--o{ paths : "has many"
  scenarios          ||--o{ steps : "has many"
  paths              ||--o{ path_steps : "has many"
  steps              ||--o{ path_steps : "has many"
  paths              ||--o{ lanes : "has many"
  paths              ||--o{ cells : "has many"
  lanes              ||--o{ cells : "has many"
  steps              ||--o{ cells : "has many"
  cells              ||--o{ cell_dependencies : "source"
  cells              ||--o{ cell_dependencies : "target"

  %% The derived layer — shipped 2026-07-29 in f65efcf, absent from every
  %% previous version of this file.
  service_lifecycles ||--o{ evidence : "has many"
  service_lifecycles ||--o{ findings : "has many"
  service_lifecycles ||--o{ slices : "has many"
  service_lifecycles ||--|| propositions : "one business model"
  slices             ||--o{ slice_items : "has many"

  %% Agent session ledger — unrelated to the blueprint tree.
  agent_sessions     ||--o{ agent_messages : "has many"

  service_lifecycles {
    uuid id PK
    text name
    text description
  }
  phases {
    uuid id PK
    uuid service_lifecycle_id FK
    uuid loops_to_phase_id FK "optional self-reference"
    text name
    text summary "the stage in one line"
    int position
    text business_impact "what this phase is worth, and what it costs"
    text operational_requirements "what must be true for it to run at all"
    text origin
  }
  scenarios {
    uuid id PK
    uuid phase_id FK
    text name
    text summary "the situation this blueprint covers"
    int position
    text view_type "single | stacked"
    text origin
  }
  paths {
    uuid id PK
    uuid scenario_id FK
    text name
    text path_type
    text summary "when this route applies"
    text note "the author's aside, not fact"
    text origin
  }
  steps {
    uuid id PK
    uuid scenario_id FK
    text name
    text summary "what this moment is, across every lane — the storyboard caption"
    text origin
  }
  path_steps {
    uuid path_id FK
    uuid step_id FK
    int position
  }
  lanes {
    uuid id PK
    uuid path_id FK
    text name
    text lane_role "semantic key, never inferred from the name"
    int position
    text owner_team
    jsonb kpis
    jsonb tools
    text origin
  }
  cells {
    uuid id PK
    uuid path_id FK
    uuid lane_id FK
    uuid step_id FK
    text content "what happens in this moment"
    text summary "the tl;dr the detail fields add up to"
    text function "why this moment exists"
    text form "tone and manner; frontstage only"
    jsonb value_props "who gets what"
    text owner "OVERRIDE of the lane's owner_team; empty means same as the lane"
    text perceived_owner "who the customer believes owns it; frontstage only"
    text picture
    jsonb links "authored URLs — resources, NOT dependencies"
    int position "order within one (lane, step) slot"
    text cell_key
    tsvector search_tsv "generated"
    text origin
  }
  cell_dependencies {
    uuid id PK
    uuid source_cell_id FK
    uuid target_cell_id FK
    text kind "sets_off = makes it happen, drawn | enables = makes it possible, never drawn"
    text label
    text note
  }
  evidence {
    uuid id PK
    uuid service_lifecycle_id FK
    uuid cell_id "XOR with proposition_question_key"
    text proposition_question_key "understand | value | usability"
    text kind
    text title
    text ref
    text excerpt
    text note
    date observed_at
    text added_by "agent name or participant code — never the interviewee"
  }
  findings {
    uuid id PK
    uuid service_lifecycle_id FK
    uuid run_id
    text source
    text check_name
    text severity
    uuid_array cell_ids
    text note
    text fingerprint
    text status "open | resolved | dismissed"
  }
  slices {
    uuid id PK
    uuid service_lifecycle_id FK
    text slice_type
    text title
    text description
    text actor
    text locale
    int position
    text origin
  }
  slice_items {
    uuid id PK
    uuid slice_id FK
    int position
    uuid_array cell_ids
    text caption
    text narrative
    jsonb illustration
  }
  propositions {
    uuid service_lifecycle_id PK
    text pricing
    text revenue_model
    text funding
    text delivery_cost
    text partners
  }
