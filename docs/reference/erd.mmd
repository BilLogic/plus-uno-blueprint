%% Service Blueprint ERD
%%
%% REGENERATED FROM THE LIVE SCHEMA on 2026-08-26, not hand-edited. The previous
%% version was generated on 2026-08-20 and was wrong the next morning: the
%% vocabulary refactor's last three migrations landed on 2026-08-21, so this
%% file spent six days asserting `service_lifecycles` and `propositions` at a
%% database that had neither. It was also missing `deleted_structure`
%% altogether, carried a `paths.path_type` enum with five values where the
%% database has three, and filed `slices.origin` under the wrong enum.
%%
%% A snapshot regenerated one day before a rename is a snapshot that lies with
%% a generation stamp on it, which is worse than one that admits it is old.
%% docs/reference/schema-snapshot-queries.sql query 4 is now asserted by
%% migration 20260826130000 rather than trusted to a human; the other three
%% still need re-running by hand whenever the schema moves.
%%
%% To refresh: re-run the queries in docs/reference/schema-snapshot-queries.sql
%% against the live database and rewrite this file plus
%% supabase/schema.reference.sql from their output.
%%
%% Enums (CHECK constraints, live 2026-08-26):
%%   scenarios.view_type      ∈ (single | stacked)  merged is session-only,
%%                                                  never stored
%%   paths.path_type          ∈ (happy | variant | exception)
%%   cell_dependencies.kind   ∈ (leads_to | enables)
%%   stakeholders.kind        ∈ (recipient | staff | partner | provider | team)
%%   evidence.kind            ∈ (interview | survey | analytics | doc | meeting |
%%                               decision | observation | other)
%%   findings.severity        ∈ (info | warn | critical)
%%   findings.source          ∈ (audit | whatif | import-sweep)
%%   findings.status          ∈ (open | resolved | dismissed)
%%   slices.slice_type        ∈ (journey | step | lane | cell | custom)
%%   slices.origin            ∈ (generated | customized | human)   NOT import|app
%%   deleted_structure.kind   ∈ (scenario | path | lane | step | cell)
%%   agent_messages.kind      ∈ (user | assistant | tool | status)
%%   origin (cells | lanes | paths | phases | scenarios | steps) ∈ (import | app)
%%
%% cells.status and paths.status are the `entity_status` DOMAIN, not a CHECK —
%% one shared six-value list, so the two tables cannot drift apart.
%%
%% Integrity: cells.path_id must match lanes.path_id AND (path_id, step_id) must
%%            exist in path_steps — DB trigger cells_validate_path_match. Import
%%            order: paths → steps → path_steps → lanes → cells → cell_dependencies.
%%            The trigger only ever sees writes to cells, so moving the LANE
%%            used to leave its cells on a path it had left, silently. Since
%%            20260830180000 the pair is also a composite foreign key —
%%            cells (lane_id, path_id) → lanes (id, path_id), referencing
%%            lanes_id_path_unique — which refuses the lane-side move too.
%%
%% Roles: lanes.lane_role is a semantic key kept separate from the display name,
%%        because inferring one from the other broke every non-English blueprint.
%%        Canonical: customer_actions, frontstage_actions, backstage_actions,
%%        partner_actions, frontstage_tech, backstage_tech, support_actions,
%%        visual. Constrained by lanes_lane_role_check, NOT extensible; null =
%%        generic swimlane, and permitted on purpose.
%%
%% Soft references: evidence.cell_id, findings.cell_ids and slice_items.cell_ids
%%        carry NO foreign key, deliberately. The importer's scenario-scoped
%%        delete-and-reinsert must never cascade into analysis-tier rows that a
%%        person authored. The paired *_cell_keys columns are how those rows are
%%        recovered when the uuids they pointed at are replaced.
erDiagram
  services           ||--o{ phases : "has many"
  phases             ||--o{ scenarios : "has many"
  phases             |o--o| phases : "loops_to_phase_id"
  scenarios          ||--o{ paths : "has many"
  scenarios          ||--o{ steps : "has many"
  paths              ||--o{ path_steps : "has many"
  steps              ||--o{ path_steps : "has many"
  paths              ||--o{ lanes : "has many"
  paths              ||--o{ cells : "has many"
  lanes              ||--o{ cells : "has many"
  steps              ||--o{ cells : "has many"
  cells              ||--o{ cell_dependencies : "source"
  cells              ||--o{ cell_dependencies : "target"

  %% The analysis tier — records ABOUT the board rather than squares of it.
  %% Shipped 2026-07-29 in f65efcf. Called the "derived layer" until 2026-08-26,
  %% a name retired because four of these five tables are authored by a person,
  %% not derived from anything.
  services           ||--o{ stakeholders : "the cast"
  stakeholders       |o--o| stakeholders : "parent_id, teams contain people"
  stakeholders       |o--o{ lanes : "lanes.stakeholder_id, NULLABLE"
  stakeholders       |o--o{ slices : "slices.stakeholder_id"

  services           ||--o{ evidence : "has many"
  services           ||--o{ findings : "has many"
  services           ||--o{ slices : "has many"
  services           ||--|| business_model : "one per service"
  slices             ||--o{ slice_items : "has many"

  %% Agent session ledger — unrelated to the blueprint tree.
  agent_sessions     ||--o{ agent_messages : "has many"

  services {
    uuid id PK
    text name
    text summary
  }
  phases {
    uuid id PK
    uuid service_id FK
    uuid loops_to_phase_id FK "optional self-reference"
    text name
    text summary "the stage in one line"
    int position
    text business_impact "what this phase is worth, and what it costs"
    text operational_requirements "what must be true for it to run at all"
    text origin
  }
  scenarios {
    uuid id PK
    uuid phase_id FK
    text name
    text summary "the situation this blueprint covers"
    int position
    text view_type "single | stacked"
    text origin
  }
  paths {
    uuid id PK
    uuid scenario_id FK
    text name
    text path_type
    text summary "when this route applies"
    text note "the author's aside, not fact"
    entity_status status
    text origin
  }
  steps {
    uuid id PK
    uuid scenario_id FK
    text name
    text summary "what this moment is, across every lane — the storyboard caption"
    text origin
  }
  path_steps {
    uuid path_id FK
    uuid step_id FK
    int position
  }
  lanes {
    uuid id PK
    uuid path_id FK
    uuid stakeholder_id FK "null on the structural rows"
    text name
    text lane_role "semantic key, never inferred from the name"
    int position
    text owner_team
    jsonb kpis
    jsonb tools
    text origin
  }
  cells {
    uuid id PK
    uuid path_id FK
    uuid lane_id FK
    uuid step_id FK
    text content "what happens in this moment"
    text summary "the tl;dr the detail fields add up to"
    text function "why this moment exists"
    text form "tone and manner; frontstage only"
    jsonb value_props "who gets what"
    text owner "OVERRIDE of the lane's owner_team; empty means same as the lane"
    text perceived_owner "who the customer believes owns it; frontstage only"
    text picture
    jsonb links "authored URLs — resources, NOT dependencies"
    int position "order within one (lane, step) slot"
    text cell_key "service/scenario/path/lane/step, slugified"
    entity_status status
    tsvector search_tsv "generated"
    text origin
  }
  cell_dependencies {
    uuid id PK
    uuid source_cell_id FK
    uuid target_cell_id FK
    text kind "leads_to = makes it happen, drawn | enables = makes it possible, never drawn"
    text label
    text note
  }
  evidence {
    uuid id PK
    uuid service_id FK
    uuid cell_id "soft, no FK. XOR with proposition_question_key"
    text cell_key "paired with cell_id — both null or both set"
    text proposition_question_key "understand | value | usability"
    text kind
    text title
    text ref
    text excerpt
    text note
    date observed_at
    text added_by "agent name or participant code — never the interviewee"
    uuid created_by
  }
  findings {
    uuid id PK
    uuid service_id FK
    uuid run_id
    text source
    text check_name
    text severity
    uuid_array cell_ids "soft, no FK"
    text_array cell_keys "same cardinality as cell_ids, enforced"
    text note
    text fingerprint "dedupe across runs"
    text status "open | resolved | dismissed"
  }
  slices {
    uuid id PK
    uuid service_id FK
    uuid stakeholder_id FK "trigger keeps actor equal to their name"
    text slice_type
    text title
    text description
    text actor
    text locale
    int position
    text origin
    uuid created_by
  }
  slice_items {
    uuid id PK
    uuid slice_id FK
    int position
    uuid_array cell_ids "soft, no FK"
    text_array cell_keys "same cardinality as cell_ids, enforced"
    text caption
    text narrative
    jsonb illustration
    uuid created_by
  }
  stakeholders {
    uuid id PK
    uuid service_id FK
    uuid parent_id FK "self-reference: a team contains its people"
    text name
    text kind "recipient | staff | partner | provider | team"
    text note
    text_array aliases "other spellings seen in this blueprint"
  }
  business_model {
    uuid service_id PK
    text funding
    text pricing
    text delivery_cost
    text revenue_model
    text partners
    uuid created_by
  }
  deleted_structure {
    uuid id PK
    timestamptz deleted_at
    uuid deleted_by
    text kind "scenario | path | lane | step | cell"
    text label
    jsonb payload "the row as it was, for the identity-keyed inverse"
    jsonb affected_slices
  }
  agent_sessions {
    uuid id PK
    text title
  }
  agent_messages {
    uuid id PK
    uuid session_id FK
    bigint seq
    text kind "user | assistant | tool | status"
    jsonb payload
  }
