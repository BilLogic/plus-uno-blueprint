{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // The build's own config, and the browser render walk beside it: both are
  // Node programs about this repository rather than part of the application,
  // and `render-walk/` ships to deployments, so its five TypeScript files are typechecked
  // here rather than only by whatever Playwright tolerates at run time.
  "include": ["vite.config.ts", "render-walk"]
}
