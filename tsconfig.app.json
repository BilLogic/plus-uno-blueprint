{
  "compilerOptions": {
    // No baseUrl: removed in TypeScript 7. `paths` resolves relative to this
    // file, which is what the mapping already assumed.
    //
    // Two roots, tried in order — see `vite.config.ts`. The second is for a
    // deployment that reads the application out of the package rather than
    // keeping a copy of it, and is never reached here.
    "paths": {
      "@/*": [
        "./src/*",
        "./node_modules/agentic-service-blueprinting/src/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // `node` is here for the token tests, which read colors.css off disk to check
    // that the TypeScript side and the stylesheet still agree.
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
